# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
UVICORN_ACCESS_LOG=false

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=
DB_SSLMODE=disable
DB_SCHEMA=
DB_SEARCH_PATH=
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=3600
# Optional override:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/talent_pool

# Browser Configuration
BROWSER_HEADLESS=false
BROWSER_USER_DATA_BASE_PATH=./user_data
BROWSER_NEW_CHAT_PER_TASK=true

# Default user for anonymous requests (before auth is implemented)
DEFAULT_USER_ID=default

# OpenAI Credentials (Optional, for auto-login)
OPENAI_EMAIL=your_email@example.com
OPENAI_PASSWORD=your_password

# Task Configuration
TASK_TIMEOUT_SECONDS=300
MAX_CONCURRENT_TASKS=3
MAX_CONCURRENT_TASKS_PER_USER=1

# Webhook Configuration
WEBHOOK_TIMEOUT_SECONDS=30
WEBHOOK_MAX_RETRIES=3

# Human-like behavior delays (milliseconds)
HUMAN_MIN_DELAY_MS=500
HUMAN_MAX_DELAY_MS=2000
TYPING_MIN_DELAY_MS=30
TYPING_MAX_DELAY_MS=100

# S3 Storage Configuration
S3_ENDPOINT_URL=http://minio:9000  # 如果使用 AWS S3 可留空
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET_NAME=chatgpt-sessions
S3_REGION_NAME=us-east-1           # 可选
