# GEO Mock Docker Environment Configuration
# Copy this file to .env and fill in the values

# ============================================
# Nginx Configuration
# ============================================
NGINX_PORT=8182

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=geo_mock
GPT_DB_NAME=gpt_interaction

# ============================================
# Server Configuration
# ============================================
NODE_ENV=production
PORT=3000
API_PREFIX=/api

# Database URL (auto-constructed in docker-compose, but can override)
# DATABASE_URL=postgres://postgres:password@postgres:5432/geo_mock

# Webhook base URL (internal docker network)
WEBHOOK_BASE_URL=http://server:3000

# ============================================
# Dify Workflow API Keys
# ============================================
DIFY_BASE_URL=http://network.jancsitech.net
DIFY_CATEGORY_API_KEY=your_dify_category_api_key_here
DIFY_ANALYSIS_API_KEY=your_dify_analysis_api_key_here
DIFY_BRAND_DUEL_PROMPTS_API_KEY=your_dify_brand_duel_prompts_api_key_here
DIFY_BRAND_DUEL_ANALYSIS_API_KEY=your_dify_brand_duel_analysis_api_key_here
DIFY_RESPONSE_MODE=blocking
DIFY_USER=geo-mock

# ============================================
# LLM API Keys (Optional)
# ============================================
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
QWEN_API_KEY=your_qwen_api_key_here

# ============================================
# GPT Interaction Service
# ============================================
# Debug mode (set to true for verbose logging)
GPT_DEBUG=false

# Task execution settings
TASK_TIMEOUT_SECONDS=300
MAX_CONCURRENT_TASKS=3
MAX_CONCURRENT_TASKS_PER_USER=1

# OpenAI Account Credentials (Optional)
# Used for automatic login to ChatGPT
OPENAI_EMAIL=your_email@example.com
OPENAI_PASSWORD=your_password_here

# Human-like behavior delays (milliseconds)
HUMAN_MIN_DELAY_MS=500
HUMAN_MAX_DELAY_MS=2000
TYPING_MIN_DELAY_MS=30
TYPING_MAX_DELAY_MS=100

# ============================================
# Web Frontend Configuration
# ============================================
VITE_BASE_PATH=/public/ecommerce
VITE_API_PREFIX=/public/ecommerce/api
