# Server Configuration
PORT=3000
WEB_PORT=5173
API_PREFIX=/api
WEBHOOK_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/geo_mock

# Base Path for embedding (used during build)
# VITE_BASE_PATH=/public/ecommerce

# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
QWEN_API_KEY=your_qwen_api_key_here
GROK_API_KEY=your_grok_api_key_here

# Dify Workflow
DIFY_BASE_URL=http://network.jancsitech.net
DIFY_CATEGORY_API_KEY=your_dify_category_api_key_here
DIFY_ANALYSIS_API_KEY=your_dify_analysis_api_key_here
DIFY_BRAND_DUEL_PROMPTS_API_KEY=your_dify_brand_duel_prompts_api_key_here
DIFY_BRAND_DUEL_ANALYSIS_API_KEY=your_dify_brand_duel_analysis_api_key_here
DIFY_RESPONSE_MODE=blocking
DIFY_USER=geo-mock

# GPT Interaction Service
GPT_INTERACTION_BASE_URL=http://localhost:8000
GPT_INTERACTION_API_PREFIX=/api/v1
GPT_INTERACTION_WEBHOOK_PATH=/api/pipelines/category/webhook
GPT_INTERACTION_BRAND_DUEL_WEBHOOK_PATH=/api/pipelines/brand-duel/webhook

# ============================================
# Docker Deployment Configuration
# ============================================

# Nginx Port
NGINX_PORT=8182

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=geo_mock
GPT_DB_NAME=gpt_interaction

# GPT Interaction Settings
GPT_DEBUG=false
TASK_TIMEOUT_SECONDS=300
MAX_CONCURRENT_TASKS=3
MAX_CONCURRENT_TASKS_PER_USER=1

# OpenAI Account (Optional, for auto-login to ChatGPT)
OPENAI_EMAIL=your_email@example.com
OPENAI_PASSWORD=your_password_here
