# Base Path for embedding (used during build)
# VITE_BASE_PATH=/public/ecommerce

# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
QWEN_API_KEY=your_qwen_api_key_here
GROK_API_KEY=your_grok_api_key_here

# Dify Workflow
DIFY_BASE_URL=http://network.jancsitech.net
DIFY_CATEGORY_API_KEY=your_dify_category_api_key_here
DIFY_ANALYSIS_API_KEY=your_dify_analysis_api_key_here
DIFY_BRAND_DUEL_PROMPTS_API_KEY=your_dify_brand_duel_prompts_api_key_here
DIFY_BRAND_DUEL_ANALYSIS_API_KEY=your_dify_brand_duel_analysis_api_key_here
